{
  "name": "rebofiles",
  "version": "0.1.0",
  "description": "A file drive for the browser, built into your application, on your own storage: folders, upload, previews, versions, trash and sharing.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @rebofiles/playground",
    "demo": "npm run dev -w @rebofiles/demo",
    "build:demo": "npm run build -w @rebofiles/demo",
    "storage": "npm run dev -w @rebofiles/storage",
    "desktop": "npm run dev -w @rebofiles/desktop",
    "build:desktop": "npm run build -w @rebofiles/desktop",
    "storage:check": "npm run check -w @rebofiles/storage",
    "storage:seed": "npm run seed -w @rebofiles/storage",
    "site": "npm run dev -w @rebofiles/site",
    "build:site": "npm run build -w @rebofiles/site",
    "test": "vitest run --project node",
    "coverage": "vitest run --project node --coverage --coverage.include='packages/*/src/**'",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/playground && tsc --noEmit -p apps/demo && tsc --noEmit -p apps/storage && tsc --noEmit -p apps/desktop",
    "lint": "biome check .",
    "format": "biome check --write .",
    "sample": "vite-node tools/sample.ts --",
    "build:packages": "npm run build -w @rebofiles/core -w @rebofiles/server -w @rebofiles/drive -w @rebofiles/react -w @rebofiles/mcp",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "2.5.15",
    "@electric-sql/pglite": "^0.5.11",
    "@playwright/test": "^1.64.1",
    "@rebodocs/core": "^0.11.0",
    "@rebodocs/editor": "^0.11.0",
    "@rebodocs/mcp": "^0.11.0",
    "@rebodocs/react": "^0.11.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.5",
    "fflate": "^0.8.3",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.5"
  }
}
